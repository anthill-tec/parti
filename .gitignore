# Machine-local overlay (values that stay on this machine) — never committed.
.env.local

# Pi project folder (agents, extensions, permission policy): auto-generated by the
# Model B scaffold (`modelb-axi init` / `modelb-axi agents`), never versioned.
.pi/

# CR worktrees live inside the repo (inheriting Pi's project trust).
.worktrees/

# Review pages (Lavish): machine-local working records; decisions live in docs/.
.lavish/

# Services ledger (parti-services skill) — machine-local run state.
.run/

# Toolchains: the python test interpreter (uv venv) and bun's installed packages.
.venv/
node_modules/

# Tooling debris.
__pycache__/
test-reports/
